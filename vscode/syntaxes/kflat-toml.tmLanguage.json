{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KFlat TOML",
  "scopeName": "source.toml.kflat",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#table"
    },
    {
      "include": "#entry"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.toml"
    },
    "table": {
      "match": "^\\s*(\\[\\[?)\\s*([^\\]]+?)\\s*(\\]\\]?)",
      "captures": {
        "1": {
          "name": "punctuation.definition.table.toml"
        },
        "2": {
          "name": "entity.name.section.toml"
        },
        "3": {
          "name": "punctuation.definition.table.toml"
        }
      }
    },
    "entry": {
      "begin": "((?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*'))*)\\s*(=)",
      "beginCaptures": {
        "1": {
          "name": "variable.other.key.toml"
        },
        "2": {
          "name": "keyword.operator.assignment.toml"
        }
      },
      "end": "(?<=\\S)(?=\\s*(?:#|$))|$",
      "patterns": [
        {
          "include": "#value"
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": ",",
          "name": "punctuation.separator.toml"
        },
        {
          "include": "#string"
        },
        {
          "match": "\\d{4}-\\d{2}-\\d{2}(?:[Tt ]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})?)?",
          "name": "constant.other.date.toml"
        },
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean.toml"
        },
        {
          "match": "[+-]?(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|(?:\\d[\\d_]*)(?:\\.[\\d_]+)?(?:[eE][+-]?\\d+)?|inf|nan)\\b",
          "name": "constant.numeric.toml"
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.array.toml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.array.toml"
            }
          },
          "patterns": [
            {
              "include": "#value"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.table.inline.toml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.table.inline.toml"
            }
          },
          "patterns": [
            {
              "include": "#inline-entry"
            },
            {
              "include": "#value"
            }
          ]
        }
      ]
    },
    "inline-entry": {
      "match": "((?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*')(?:\\s*\\.\\s*(?:[A-Za-z0-9_-]+|\"[^\"]*\"|'[^']*'))*)\\s*(=)",
      "captures": {
        "1": {
          "name": "variable.other.key.toml"
        },
        "2": {
          "name": "keyword.operator.assignment.toml"
        }
      }
    },
    "string": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"(?!\")",
          "name": "string.quoted.triple.basic.toml",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "begin": "'''",
          "end": "'''(?!')",
          "name": "string.quoted.triple.literal.toml"
        },
        {
          "begin": "\"",
          "end": "\"|$",
          "name": "string.quoted.double.basic.toml",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'|$",
          "name": "string.quoted.single.literal.toml"
        }
      ]
    },
    "escape": {
      "match": "\\\\(?:[btnfr\"\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
      "name": "constant.character.escape.toml"
    }
  }
}
