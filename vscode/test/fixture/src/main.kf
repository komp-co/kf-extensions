struct Point {
    val x: int32
    val y: int32
}

impl Point {
    fun sum(): int32 {
        return self.x + self.y
    }
}

fun twice(n: int32): int32 {
    return n * 2
}

fun main(): int32 {
    val p = Point { x: 1, y: 2 }
    val total = p.sum()
    val doubled = twice(total)
    return doubled - p.x - 5
}
