{
  "name": "vscode-kflat",
  "displayName": "KFlat",
  "description": "KFlat language support: a client of the KFlat language server (`komp lsp`) for .kf files, kf.toml and lint.toml, with komp's build, run, test and check tasks.",
  "version": "0.1.0",
  "publisher": "kflat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/komp-co/kf-extensions.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/kf.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kflat",
        "aliases": [
          "KFlat",
          "kflat"
        ],
        "extensions": [
          ".kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-light.svg",
          "dark": "./icons/kflat-dark.svg"
        }
      },
      {
        "id": "kflat-test",
        "aliases": [
          "KFlat Test"
        ],
        "filenamePatterns": [
          "*_test.kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-test-light.svg",
          "dark": "./icons/kflat-test-dark.svg"
        }
      },
      {
        "id": "kflat-manifest",
        "aliases": [
          "KFlat Manifest"
        ],
        "filenames": [
          "kf.toml"
        ],
        "icon": {
          "light": "./icons/kflat-manifest-light.svg",
          "dark": "./icons/kflat-manifest-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lock",
        "aliases": [
          "KFlat Lockfile"
        ],
        "filenames": [
          "kf.lock"
        ],
        "icon": {
          "light": "./icons/kflat-lock-light.svg",
          "dark": "./icons/kflat-lock-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lints",
        "aliases": [
          "KFlat Lints"
        ],
        "filenames": [
          "lint.toml"
        ],
        "icon": {
          "light": "./icons/kflat-lint-light.svg",
          "dark": "./icons/kflat-lint-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kflat",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-test",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-manifest",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lock",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lints",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kflat.restartServer",
        "title": "KFlat: Restart the language server"
      }
    ],
    "configuration": {
      "title": "KFlat",
      "properties": {
        "kflat.kompPath": {
          "type": "string",
          "default": "komp",
          "markdownDescription": "Path to the `komp` binary. Resolved on `PATH` when left as a bare name. The extension starts `komp lsp` with it."
        },
        "kflat.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server in the KFlat output."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.documentation.kflat",
            "settings": {
              "fontStyle": "italic"
            }
          }
        ]
      },
      "[kflat-manifest]": {
        "editor.quickSuggestions": {
          "strings": "on"
        }
      },
      "[kflat-lints]": {
        "editor.quickSuggestions": {
          "strings": "on"
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "komp",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The komp command: build, run, test or check."
          },
          "crate": {
            "type": "string",
            "description": "The crate directory, relative to the workspace folder; the folder itself when left out."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "komp",
        "owner": "komp",
        "source": "komp",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|note): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run compile -- --minify",
    "generate-grammar": "node scripts/generate-grammar.js",
    "test": "node scripts/generate-grammar.js --check && node scripts/test-grammar.js && node scripts/test-toml-grammar.js && node scripts/test-problem-matcher.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "icon": "images/icon.png",
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
