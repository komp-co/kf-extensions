{
  "name": "vscode-kflat",
  "displayName": "KFlat",
  "description": "KFlat language support: highlighting generated from komp's lexer tables, and diagnostics, hover, completion, navigation, rename and the rest from the language server, komp lsp.",
  "version": "0.2.0",
  "publisher": "kflat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/komp-co/kf-extensions.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/kf.toml",
    "onLanguage:kflat",
    "onLanguage:kflat-test",
    "onLanguage:kflat-manifest",
    "onLanguage:kflat-lints"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kflat",
        "aliases": [
          "KFlat",
          "kflat"
        ],
        "extensions": [
          ".kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-light.svg",
          "dark": "./icons/kflat-dark.svg"
        }
      },
      {
        "id": "kflat-test",
        "aliases": [
          "KFlat Test"
        ],
        "filenamePatterns": [
          "*_test.kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-test-light.svg",
          "dark": "./icons/kflat-test-dark.svg"
        }
      },
      {
        "id": "kflat-manifest",
        "aliases": [
          "KFlat Manifest"
        ],
        "filenames": [
          "kf.toml"
        ],
        "icon": {
          "light": "./icons/kflat-manifest-light.svg",
          "dark": "./icons/kflat-manifest-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lock",
        "aliases": [
          "KFlat Lockfile"
        ],
        "filenames": [
          "kf.lock"
        ],
        "icon": {
          "light": "./icons/kflat-lock-light.svg",
          "dark": "./icons/kflat-lock-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lints",
        "aliases": [
          "KFlat Lints"
        ],
        "filenames": [
          "lint.toml"
        ],
        "icon": {
          "light": "./icons/kflat-lint-light.svg",
          "dark": "./icons/kflat-lint-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kflat",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-test",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-manifest",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lock",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lints",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kflat.restartServer",
        "title": "KFlat: Restart the language server"
      },
      {
        "command": "kflat.run",
        "title": "KFlat: Run the crate"
      },
      {
        "command": "kflat.test",
        "title": "KFlat: Run one test"
      }
    ],
    "configuration": {
      "title": "KFlat",
      "properties": {
        "kflat.kompPath": {
          "type": "string",
          "default": "komp",
          "markdownDescription": "Path to the `komp` binary, which starts the language server with `komp lsp`. Resolved on `PATH` when left as a bare name."
        },
        "kflat.warnOnStaleBinary": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when `kflat.kompPath` points inside a komp checkout and was built before that checkout's newest change to `compiler/`. Has no effect on a komp installed from elsewhere, which has no tree to be behind."
        },
        "kflat.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server to the KFlat output."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.documentation.kflat",
            "settings": {
              "fontStyle": "italic"
            }
          }
        ]
      },
      "[kflat]": {
        "editor.autoIndentOnPaste": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "kflat.run",
          "when": "false"
        },
        {
          "command": "kflat.test",
          "when": "false"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "kflat",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The komp command the task runs."
          }
        }
      }
    ]
  },
  "scripts": {
    "generate-grammar": "node scripts/generate-grammar.js",
    "test": "node scripts/generate-grammar.js --check && node scripts/test-grammar.js && node scripts/test-toml-grammar.js && node scripts/test-staleness.js && node scripts/test-projects.js",
    "test-editor": "node scripts/test-editor.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "icon": "images/icon.png"
}
