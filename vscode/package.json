{
  "name": "vscode-kflat",
  "displayName": "KFlat",
  "description": "KFlat language support: syntax highlighting generated from komp's lexer tables, diagnostics from komp check, and an outline, folding ranges, hover and inlay hints from komp query.",
  "version": "0.1.0",
  "publisher": "kflat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/komp-co/kf-extensions.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/kf.toml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kflat",
        "aliases": [
          "KFlat",
          "kflat"
        ],
        "extensions": [
          ".kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-light.svg",
          "dark": "./icons/kflat-dark.svg"
        }
      },
      {
        "id": "kflat-test",
        "aliases": [
          "KFlat Test"
        ],
        "filenamePatterns": [
          "*_test.kf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kflat-test-light.svg",
          "dark": "./icons/kflat-test-dark.svg"
        }
      },
      {
        "id": "kflat-manifest",
        "aliases": [
          "KFlat Manifest"
        ],
        "filenames": [
          "kf.toml"
        ],
        "icon": {
          "light": "./icons/kflat-manifest-light.svg",
          "dark": "./icons/kflat-manifest-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lock",
        "aliases": [
          "KFlat Lockfile"
        ],
        "filenames": [
          "kf.lock"
        ],
        "icon": {
          "light": "./icons/kflat-lock-light.svg",
          "dark": "./icons/kflat-lock-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      },
      {
        "id": "kflat-lints",
        "aliases": [
          "KFlat Lints"
        ],
        "filenames": [
          "lint.toml"
        ],
        "icon": {
          "light": "./icons/kflat-lint-light.svg",
          "dark": "./icons/kflat-lint-dark.svg"
        },
        "configuration": "./toml-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kflat",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-test",
        "scopeName": "source.kflat",
        "path": "./syntaxes/kflat.tmLanguage.json"
      },
      {
        "language": "kflat-manifest",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lock",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      },
      {
        "language": "kflat-lints",
        "scopeName": "source.toml.kflat",
        "path": "./syntaxes/kflat-toml.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kflat.check",
        "title": "KFlat: Run komp check on this crate"
      }
    ],
    "configuration": {
      "title": "KFlat",
      "properties": {
        "kflat.kompPath": {
          "type": "string",
          "default": "komp",
          "markdownDescription": "Path to the `komp` binary. Resolved on `PATH` when left as a bare name."
        },
        "kflat.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run komp check on the file's crate when a .kf file is saved."
        },
        "kflat.checkOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run komp check when a .kf file is opened."
        },
        "kflat.checkTimeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "Milliseconds before a running komp check is killed."
        },
        "kflat.queryTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "Milliseconds before a komp query backing the outline, folding ranges, hover or inlay hints is killed. Hover and inlay hints check the whole crate, so they need more than the parse-only queries."
        },
        "kflat.warnOnStaleBinary": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when `kflat.kompPath` points inside a komp checkout and was built before that checkout's newest change to `compiler/`. Has no effect on a komp installed from elsewhere, which has no tree to be behind."
        }
      }
    },
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.documentation.kflat",
            "settings": {
              "fontStyle": "italic"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "generate-grammar": "node scripts/generate-grammar.js",
    "test": "node scripts/generate-grammar.js --check && node scripts/test-grammar.js && node scripts/test-toml-grammar.js && node scripts/test-staleness.js"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.0.0"
  },
  "icon": "images/icon.png"
}
